{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": { "noProcessEnv": "error" }
		}
	},
	"overrides": [
		{
			"includes": ["src/app/**", "scripts/**"],
			"linter": { "rules": { "style": { "noProcessEnv": "off" } } }
		}
	]
}
